generator client {
  provider = "prisma-client-js"
  output = "../generated/postgres"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(100)
  passwordHash String? @db.VarChar(255)
  role String @default("USER") @db.VarChar(12)
  createdAt DateTime @default(now())
  sessions Session[]
  favorites Favorite[]
  plans MealPlan[]
  googleIdentity GoogleIdentity?
}
model GoogleIdentity {
  subject String @id @db.VarChar(255)
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Ingredient {
  id String @id @db.VarChar(80)
  name String @db.VarChar(160)
  aliasesText String @db.VarChar(1000)
  unit String @db.VarChar(16)
  category String @db.VarChar(60)
  lines RecipeLine[]
}
model Recipe {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(180)
  revision Int @default(1)
  title String @db.VarChar(180)
  summary String @db.VarChar(1000)
  cuisine String @db.VarChar(12)
  category String @db.VarChar(60)
  image String @db.VarChar(1000)
  imageCredit String @db.VarChar(200)
  baseServings Int
  prepMinutes Int?
  cookMinutes Int?
  waitMinutes Int?
  totalMinutes Int?
  timingStatus String @default("ESTIMATED") @db.VarChar(16)
  preconditions String @db.VarChar(500)
  difficulty String @db.VarChar(60)
  contentStatus String @default("DRAFT") @db.VarChar(16)
  sourceUrl String @db.VarChar(2048)
  sourceName String @db.VarChar(200)
  createdAt DateTime @default(now())
  lines RecipeLine[]
  steps RecipeStep[]
  favorites Favorite[]
  entries MealEntry[]
  @@index([cuisine, contentStatus])
}
model RecipeLine {
  id String @id @default(uuid()) @db.Uuid
  recipeId String @db.Uuid
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingredientId String @db.VarChar(80)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity Decimal? @db.Decimal(18,6)
  unit String @db.VarChar(16)
  optional Boolean @default(false)
  role String @db.VarChar(16)
  note String? @db.VarChar(300)
  sortOrder Int
  @@unique([recipeId, sortOrder])
  @@index([ingredientId, recipeId])
}
model RecipeStep {
  id String @id @default(uuid()) @db.Uuid
  recipeId String @db.Uuid
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order Int
  title String @db.VarChar(120)
  instruction String @db.Text
  @@unique([recipeId, order])
}
model Favorite {
  userId String @db.Uuid
  recipeId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  @@id([userId, recipeId])
}
model MealPlan {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  weekStart String @db.Char(10)
  version Int @default(1)
  createdAt DateTime @default(now())
  entries MealEntry[]
  shopping ShoppingList?
  @@unique([userId, weekStart])
}
model MealEntry {
  id String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid
  plan MealPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipeId String @db.Uuid
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date String @db.Char(10)
  mealType String @db.VarChar(16)
  servings Int
  clientKey String @unique @db.VarChar(100)
  @@index([planId, date])
}
model ShoppingList {
  id String @id @default(uuid()) @db.Uuid
  planId String @unique @db.Uuid
  plan MealPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planVersion Int
  version Int @default(1)
  items ShoppingItem[]
}
model ShoppingItem {
  id String @id @default(uuid()) @db.Uuid
  listId String @db.Uuid
  list ShoppingList @relation(fields: [listId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingredientId String @db.VarChar(80)
  name String @db.VarChar(160)
  category String @db.VarChar(60)
  unit String @db.VarChar(16)
  quantity Decimal? @db.Decimal(18,6)
  purchased Boolean @default(false)
  sourcesText String @db.Text
  @@unique([listId, ingredientId, unit])
}
