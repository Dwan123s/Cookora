NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Cookora
DB_USER=cookora_app
# Generate local .env with node scripts/setup-env.mjs; do not use these placeholders.
DB_PASSWORD=CHANGE_ME
DB_ENCRYPT=true
DB_TRUST_CERT=true
MSSQL_SA_PASSWORD=CHANGE_ME
CSRF_SECRET=CHANGE_ME
SEED_DEMO=true

# Google Cloud Vertex AI Configuration
# API key: Vertex AI Express, không cần Project ID hoặc file credentials.
# ADC: điền Project ID và cấu hình thông tin xác thực riêng trên máy/server.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# Chỉ dùng cho ADC, phải là đường dẫn hợp lệ trên máy/container chạy backend.
GOOGLE_APPLICATION_CREDENTIALS=
# Chỉ điền key thật trong .env local, không điền trong file mẫu hoặc frontend.
VERTEX_API_KEY=
