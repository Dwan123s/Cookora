NODE_ENV=development
# Local SQL Server stays the default. Cloud Neon uses DATABASE_PROVIDER=postgresql.
DATABASE_PROVIDER=sqlserver
# PostgreSQL only: runtime pooled URL; direct migration URL stays off the public API.
DATABASE_URL=
# Neon CLI uses this name for the direct migration connection.
DATABASE_URL_UNPOOLED=
# Optional limited app-role URL; preferred over CLI owner DATABASE_URL at runtime.
NEON_RUNTIME_DATABASE_URL=
DIRECT_URL=
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Cookora
DB_USER=cookora_app
# Generate local .env with node scripts/setup-env.mjs; do not use these placeholders.
DB_PASSWORD=CHANGE_ME
DB_ENCRYPT=true
DB_TRUST_CERT=true
MSSQL_SA_PASSWORD=CHANGE_ME
CSRF_SECRET=CHANGE_ME
SEED_DEMO=true

# Google Sign-In: OAuth client type Web application (separate from Vertex API key).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to APP_ORIGIN + /api/v1/auth/google/callback.
# Local Vite: http://localhost:5173/api/v1/auth/google/callback
# Docker: http://localhost:8080/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# Google Cloud Vertex AI Configuration
# API key: Vertex AI Express, không cần Project ID hoặc file credentials.
# ADC: điền Project ID và cấu hình thông tin xác thực riêng trên máy/server.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.7-flash
# Chỉ dùng cho ADC, phải là đường dẫn hợp lệ trên máy/container chạy backend.
GOOGLE_APPLICATION_CREDENTIALS=
# Chỉ điền key thật trong .env local, không điền trong file mẫu hoặc frontend.
VERTEX_API_KEY=
