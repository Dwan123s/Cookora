# Copy to root .env.neon-app (Git-ignored). Use the limited cookora_app role.
NODE_ENV=production
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://cookora_app:REPLACE_PASSWORD@REPLACE_ENDPOINT-pooler.neon.tech/neondb?sslmode=verify-full
# One-off local seed only; DO NOT set this flag on Render.
ALLOW_CATALOG_IMPORT=true
